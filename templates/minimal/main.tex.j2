% Minimal CV (cv-templates/Minimal_CV_Template.tex), generated by CV Creator from cv.yaml.
\documentclass[<< meta.paper >>paper,<< meta.font_size >>]{article}
\usepackage[bottom=0.8in,top=0.8in, left=0.8in,right=0.8in]{geometry}

% non-numbered pages
\pagestyle{empty}

\usepackage{iftex}
\ifPDFTeX
%%%%%%%%%%% pdflatex %%%%%%%%%
\usepackage[T1]{fontenc}
\usepackage{newtxmath,newtxtext}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\else
%%%%%%%%%%% xelatex %%%%%%%%%%%%%%
\usepackage{fontspec}
\setmainfont{TeX Gyre Termes}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\fi
\usepackage[<< meta.babel >>]{babel}

%A Few Useful Packages
\usepackage{parskip}
\usepackage{titlesec}
\usepackage{multirow}
\usepackage{graphicx}
\usepackage[usenames,dvipsnames]{xcolor}
\usepackage{enumitem}
\usepackage{hyperref}
<% if meta.accent %>
\definecolor{linkcolour}{HTML}{<< meta.accent >>}
<% else %>
\definecolor{linkcolour}{rgb}{0,0.2,0.6}
<% endif %>
\hypersetup{colorlinks,breaklinks,urlcolor={linkcolour!90}, linkcolor={linkcolour!90},
  pdftitle={<< meta.pdf_title >>}, pdfauthor={<< cv.header.name >>}}

% line spacing
\linespread{1.1}

% section reformatting
\titleformat{\section}{\color{black} \large}{}{0em}{}[\color{black}]
\titlespacing{\section}{0pt}{3pt}{3pt}

\newcommand{\sectitle}[1]{
    \vspace{1.5ex}
    \section{#1}
    \vspace{-3ex}
    \noindent\rule{\textwidth}{0.7pt}
    \vspace{-4ex}
}

% new text bold style
\newsavebox\CBox
\def\textBF#1{\sbox\CBox{#1}\resizebox{\wd\CBox}{\ht\CBox}{\textcolor{linkcolour}{{#1}}}}
\parindent=0pt

% compact bullet lists under positions and projects
\setlist[itemize]{leftmargin=1.2em, topsep=1pt, itemsep=0pt, parsep=1pt}

<# ------------------------------------------------------------------ section renderers #>
<% macro bullets(items) %>
<% if items %>
\begin{itemize}
<% for b in items %>
  \item << b.text >>
<% endfor %>
\end{itemize}
<% endif %>
<% endmacro %>

<% macro section_summary() %>
%%% Short paragraph
<< cv.summary >>
<% endmacro %>

<% macro section_competencies() %>
\sectitle{<< labels.competencies >>}

<% for c in cv.competencies %>
\textBF{<< c.name >>}<% if c.text %> --- << c.text >><% endif %>\par

<% endfor %>
<% endmacro %>

<% macro section_skills() %>
\sectitle{<< labels.skills >>}

<% for s in cv.skills %>
<% if s.category %>\textBF{<< s.category >>} --- <% endif %><< s['items'] | join(', ') >>

<% endfor %>
<% endmacro %>

<% macro jobs(title, entries) %>
\sectitle{<< title >>}

<% for r in entries %>
\textBF{<< r.title >>} --- << r.organization >><% if r.location %>, << r.location >><% endif %> \hfill << r.dates >>
<% if r.description %>

\textit{<< r.description >>}
<% endif %>
<< bullets(r.bullets) >>

<% endfor %>
<% endmacro %>

<% macro section_experience() %>
<< jobs(labels.experience, cv.experience) >>
<% endmacro %>

<% macro section_volunteering() %>
<< jobs(labels.volunteering, cv.volunteering) >>
<% endmacro %>

<% macro section_projects() %>
\sectitle{<< labels.projects >>}

<% for p in cv.projects %>
<% if p.url %>\href{<< p.url >>}{\textBF{<< p.name >>}}<% else %>\textBF{<< p.name >>}<% endif %><% if p.tech %> --- << p.tech | join(', ') >><% endif %> \hfill << p.dates >>
<% if p.description %>

<< p.description >>
<% endif %>
<< bullets(p.bullets) >>

<% endfor %>
<% endmacro %>

<% macro section_education() %>
\sectitle{<< labels.education >>}

<% for e in cv.education %>
\textBF{<< e.degree or e.institution >>}<% if e.field %>, << e.field >><% endif %><% if e.degree %> -- {<< e.institution >><% if e.location %>, << e.location >><% endif %>}<% endif %> \hfill {<< e.dates >>}
<% if e.details %>
\begin{itemize}
<% for d in e.details %>
  \item << d >>
<% endfor %>
\end{itemize}
<% endif %>

<% endfor %>
<% endmacro %>

<% macro section_certifications() %>
\sectitle{<< labels.certifications >>}

<% for c in cv.certifications %>
\textBF{<< c.name >>}<% if c.issuer %> --- << c.issuer >><% endif %> \hfill << c.when >>

<% endfor %>
<% endmacro %>

<% macro section_languages() %>
\sectitle{<< labels.languages >>}

<% for l in cv.languages %>\textBF{<< l.language >>}<% if l.level %> --- << l.level >><% endif %><% if not loop.last %> \quad <% endif %><% endfor %>

<% endmacro %>

<% macro section_awards() %>
\sectitle{<< labels.awards >>}

<% for a in cv.awards %>
\textBF{<< a.name >>}<% if a.issuer %> --- << a.issuer >><% endif %><% if a.description %>, << a.description >><% endif %> \hfill << a.dates >>

<% endfor %>
<% endmacro %>

<% macro section_publications() %>
\sectitle{<< labels.publications >>}

<% for p in cv.publications %>
<% if p.authors %><< p.authors >>. <% endif %><% if p.url %>\href{<< p.url >>}{\textit{<< p.title >>}}<% else %>\textit{<< p.title >>}<% endif %><% if p.venue %>. << p.venue >><% endif %><% if p.year %>, << p.year >><% endif %>.

<% endfor %>
<% endmacro %>

<% macro section_achievements() %>
\sectitle{<< labels.achievements >>}

<% for a in cv.achievements %>
\textBF{<< a.title >>}<% if a.text %> --- << a.text >><% endif %>\par

<% endfor %>
<% endmacro %>

<% macro section_interests() %>
\sectitle{<< labels.interests >>}

<< cv.interests | join(', ') >>

<% endmacro %>

<% macro section_references() %>
\sectitle{<< labels.references >>}

<< cv.references >>

<% endmacro %>

<% macro section_custom() %>
<% for c in cv.custom %>
\sectitle{<< c.title >>}

<% if c.text %>
<< c.text >>

<% endif %>
<% if c['items'] %>
\begin{itemize}
<% for i in c['items'] %>
  \item << i >>
<% endfor %>
\end{itemize}
<% endif %>
<% endfor %>
<% endmacro %>

<% set render_section = {
  'summary': section_summary, 'experience': section_experience, 'volunteering': section_volunteering,
  'projects': section_projects, 'education': section_education, 'skills': section_skills,
  'certifications': section_certifications, 'languages': section_languages, 'awards': section_awards,
  'publications': section_publications, 'competencies': section_competencies,
  'achievements': section_achievements, 'interests': section_interests, 'references': section_references,
  'custom': section_custom} %>
%-------------------- Begin document ----------------------
\begin{document}

%-------------------- Title section ----------------------
\begin{minipage}{\textwidth}
    \vspace{7ex}
        \par{
        \centering
        \vspace{-0.9in}
            \textcolor{linkcolour}{\Large << cv.header.name >>}
<% if cv.header.headline %>
            \\[2pt] {\normalsize << cv.header.headline >>}
<% endif %>
        \par}
\end{minipage}

%-------------------- Header ----------------------
<% set parts = [] %>
<% if cv.header.location %><% set _ = parts.append(cv.header.location) %><% endif %>
<% if cv.header.phone %><% set _ = parts.append(cv.header.phone) %><% endif %>
<% if cv.header.email %><% set _ = parts.append('\\href{' ~ cv.header.email_url ~ '}{' ~ cv.header.email ~ '}') %><% endif %>
<% for l in cv.header.links %><% set _ = parts.append('\\href{' ~ l.url ~ '}{' ~ l.label ~ '}') %><% endfor %>
\begin{center}
    << parts | join(' \\,$\\cdot$\\, ') >>
\end{center}

%-------------------- SECTIONS ----------------------
<% for key in meta.sections %>

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
<< render_section[key]() >>
<% endfor %>
<% if cv.gdpr_clause %>

\vfill
{\scriptsize << cv.gdpr_clause >>\par}
<% endif %>

\end{document}
