\pagestyle{fancy}
\fancyhf{} % clear all header and footer fields
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% Adjust margins
\addtolength{\oddsidemargin}{-0.5in}
\addtolength{\evensidemargin}{-0.5in}
\addtolength{\textwidth}{1in}
\addtolength{\topmargin}{-.5in}
\addtolength{\textheight}{1.0in}

\urlstyle{same}

\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

% Sections formatting
\titleformat{\section}{
  \vspace{-4pt}\scshape\raggedright\large
}{}{0em}{}[\color{black}\titlerule \vspace{-5pt}]

% Ensure that generate pdf is machine readable/ATS parsable
\ifPDFTeX
  \pdfgentounicode=1
\fi

%-------------------------
% Custom commands
\newcommand{\resumeItem}[1]{
  \item\small{
    {#1 \vspace{-2pt}}
  }
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-2pt}\item
    \begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & #2 \\
      \textit{\small#3} & \textit{\small #4} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeSubSubheading}[2]{
    \item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
      \textit{\small#1} & \textit{\small #2} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeProjectHeading}[2]{
    \item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
      \small#1 & #2 \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeSubItem}[1]{\resumeItem{#1}\vspace{-4pt}}

\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.15in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-5pt}}

<# ------------------------------------------------------------------ section renderers #>
<% macro block(title, lines) %>
\section{<< title >>}
 \begin{itemize}[leftmargin=0.15in, label={}]
    \small{\item{
<% for line in lines %>
     << line >><% if not loop.last %> \\<% endif %>
<% endfor %>
    }}
 \end{itemize}
<% endmacro %>

<# lead: the entry's context line (T-8), in the same list as the bullets so no gap opens between them #>
<% macro bullets(items, lead='', italic=false) %>
<% if items or lead %>
      \resumeItemListStart
<% if lead %>
        \item[]\small{<% if italic %>\textit{<< lead >>}<% else %><< lead >><% endif %> \vspace{-2pt}}
<% endif %>
<% for b in items %>
        \resumeItem{<< b.text >>}
<% endfor %>
      \resumeItemListEnd
<% endif %>
<% endmacro %>

<% macro jobs(title, groups) %>
\section{<< title >>}
  \resumeSubHeadingListStart
<% for g in groups %>
<% for r in g.roles %>
<% if loop.first %>
    \resumeSubheading
      {<< r.title >>}{<< r.dates >>}
      {<< g.organization >>}{<< r.location or g.location >>}
<% else %>
    \resumeSubSubheading
      {<< r.title >>}{<< r.dates >>}
<% endif %>
<< bullets(r.bullets, r.description, true) >>
<% endfor %>
<% endfor %>
  \resumeSubHeadingListEnd
<% endmacro %>

<% macro section_summary() %>
<< block(labels.summary, [cv.summary]) >>
<% endmacro %>

<% macro section_experience() %>
<< jobs(labels.experience, cv.experience_groups) >>
<% endmacro %>

<% macro section_volunteering() %>
\section{<< labels.volunteering >>}
  \resumeSubHeadingListStart
<% for r in cv.volunteering %>
    \resumeSubheading
      {<< r.title >>}{<< r.dates >>}
      {<< r.organization >>}{<< r.location >>}
<< bullets(r.bullets) >>
<% endfor %>
  \resumeSubHeadingListEnd
<% endmacro %>

<% macro section_projects() %>
\section{<< labels.projects >>}
    \resumeSubHeadingListStart
<% for p in cv.projects %>
      \resumeProjectHeading
          {<% if p.url %>\href{<< p.url >>}{\textbf{<< p.name >>}}<% else %>\textbf{<< p.name >>}<% endif %><% if p.role %> $|$ << p.role >><% endif %><% if p.tech %> $|$ \emph{<< p.tech | join(', ') >>}<% endif %>}{<< p.dates >>}
<< bullets(p.bullets, p.description) >>
<% endfor %>
    \resumeSubHeadingListEnd
<% endmacro %>

<% macro section_education() %>
\section{<< labels.education >>}
  \resumeSubHeadingListStart
<% for e in cv.education %>
    \resumeSubheading
      {<< e.institution >>}{<< e.location >>}
      {<< e.degree_line >>}{<< e.dates >>}
<% if e.details %>
      \resumeItemListStart
<% for d in e.details %>
        \resumeItem{<< d >>}
<% endfor %>
      \resumeItemListEnd
<% endif %>
<% endfor %>
  \resumeSubHeadingListEnd
<% endmacro %>

<% macro section_skills() %>
<% set lines = [] %>
<% for s in cv.skills %>
<% set _ = lines.append(('\\textbf{' ~ s.category ~ '}{: ' if s.category else '{') ~ s['items'] | join(', ') ~ '}') %>
<% endfor %>
<< block(labels.skills, lines) >>
<% endmacro %>

<% macro section_certifications() %>
<% set lines = [] %>
<% for c in cv.certifications %>
<% set _ = lines.append('\\textbf{' ~ c.name ~ '}' ~ (', ' ~ c.issuer if c.issuer else '') ~ (' \\hfill ' ~ c.when if c.when else '')) %>
<% endfor %>
<< block(labels.certifications, lines) >>
<% endmacro %>

<% macro section_languages() %>
<% set parts = [] %>
<% for l in cv.languages %>
<% set _ = parts.append('\\textbf{' ~ l.language ~ '}' ~ (' (' ~ l.level ~ ')' if l.level else '')) %>
<% endfor %>
<< block(labels.languages, [parts | join(', ')]) >>
<% endmacro %>

<% macro section_awards() %>
<% set lines = [] %>
<% for a in cv.awards %>
<% set _ = lines.append('\\textbf{' ~ a.name ~ '}' ~ (', ' ~ a.issuer if a.issuer else '') ~ (': ' ~ a.description if a.description else '') ~ (' \\hfill ' ~ a.dates if a.dates else '')) %>
<% endfor %>
<< block(labels.awards, lines) >>
<% endmacro %>

<% macro section_publications() %>
<% set lines = [] %>
<% for p in cv.publications %>
<% set _ = lines.append((p.authors ~ '. ' if p.authors else '') ~ (('\\href{' ~ p.url ~ '}{\\textit{' ~ p.title ~ '}}') if p.url else ('\\textit{' ~ p.title ~ '}')) ~ ('. ' ~ p.venue if p.venue else '') ~ (', ' ~ p.year if p.year else '')) %>
<% endfor %>
<< block(labels.publications, lines) >>
<% endmacro %>

<% macro section_competencies() %>
<% set lines = [] %>
<% for c in cv.competencies %>
<% set _ = lines.append('\\textbf{' ~ c.name ~ '}' ~ (': ' ~ c.text if c.text else '')) %>
<% endfor %>
<< block(labels.competencies, lines) >>
<% endmacro %>

<% macro section_achievements() %>
\section{<< labels.achievements >>}
  \resumeSubHeadingListStart
    \item[]
      \resumeItemListStart
<% for a in cv.achievements %>
        \resumeItem{<% if a.title %>\textbf{<< a.title >>}<% if a.text %>: <% endif %><% endif %><< a.text >>}
<% endfor %>
      \resumeItemListEnd
  \resumeSubHeadingListEnd
<% endmacro %>

<% macro section_interests() %>
<< block(labels.interests, [cv.interests | join(', ')]) >>
<% endmacro %>

<% macro section_references() %>
<< block(labels.references, [cv.references]) >>
<% endmacro %>

<% macro section_custom() %>
<% for c in cv.custom %>
<< block(c.title, ([c.text] if c.text else []) + c['items']) >>
<% endfor %>
<% endmacro %>

<% set render_section = {
  'summary': section_summary, 'experience': section_experience, 'volunteering': section_volunteering,
  'projects': section_projects, 'education': section_education, 'skills': section_skills,
  'certifications': section_certifications, 'languages': section_languages, 'awards': section_awards,
  'publications': section_publications, 'competencies': section_competencies,
  'achievements': section_achievements, 'interests': section_interests, 'references': section_references,
  'custom': section_custom} %>
%-------------------------------------------
%%%%%%  RESUME STARTS HERE  %%%%%%%%%%%%%%%%%%%%%%%%%%%%


\begin{document}

%----------HEADING----------
<% set parts = [] %>
<% if cv.header.location %><% set _ = parts.append(cv.header.location) %><% endif %>
<% if cv.header.phone %><% set _ = parts.append(cv.header.phone) %><% endif %>
<% if cv.header.email %><% set _ = parts.append('\\href{' ~ cv.header.email_url ~ '}{\\underline{' ~ cv.header.email ~ '}}') %><% endif %>
<% for l in cv.header.links %><% set _ = parts.append('\\href{' ~ l.url ~ '}{\\underline{' ~ l.label ~ '}}') %><% endfor %>
\begin{center}
    \textbf{\Huge \scshape << cv.header.name >>} \\ \vspace{1pt}
<% if cv.header.headline %>
    << cv.header.headline >> \\ \vspace{1pt}
<% endif %>
    \small << parts | join(' $|$ ') >>
\end{center}

<% for key in meta.sections %>

%-----------<< key | upper >>-----------
<< render_section[key]() >>
<% endfor %>
<% if cv.gdpr_clause %>

\vfill
{\scriptsize << cv.gdpr_clause >>\par}
<% endif %>

%-------------------------------------------
\end{document}
