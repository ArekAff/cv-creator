  \input{glyphtounicode}
  \usepackage[T1]{fontenc}
  \usepackage{lmodern}
\fi
\usepackage{latexsym}
\usepackage[empty]{fullpage}
\usepackage{titlesec}
\usepackage{marvosym}
\usepackage[usenames,dvipsnames]{color}
\usepackage{verbatim}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
\usepackage[<< meta.babel >>]{babel}
\usepackage{tabularx}
\hypersetup{pdftitle={<< meta.pdf_title >>}, pdfauthor={<< cv.header.name >>}}


