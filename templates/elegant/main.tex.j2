% This template is designed to offer an aesthetically pleasing resume that adheres to a formal and institutional tone, making it suitable for applications to companies and research centers requiring a high degree of professionalism. Navy blue has been chosen as the primary color to align with these objectives.
% Author: Christian Maria Giannetti
% Generated by CV Creator from cv.yaml (resume.cls: compatible reimplementation, see files/resume.cls).

%----------------------------------------------------------------------------------------
%  Packages And Other Document Configurations
%----------------------------------------------------------------------------------------

\documentclass[<< meta.paper >>paper]{resume} % Use the custom resume.cls style

% Document margins
\usepackage[left=0.75in,top=0.6in,right=0.75in,bottom=0.6in]{geometry}

% Color and hyperlink packages
\usepackage{xcolor}
\usepackage{hyperref}
\usepackage[<< meta.babel >>]{babel}

% Footnote and margin adjustment packages
\usepackage{footnote}
\usepackage{changepage}

% Fontawesome package for icons
\usepackage{fontawesome}

% Tabularx package for custom tables
\usepackage{tabularx}

% Define navyblue color
<% if meta.accent %>
\definecolor{navyblue}{HTML}{<< meta.accent >>}
<% else %>
\definecolor{navyblue}{RGB}{0,54,123}
<% endif %>
\colorlet{sectioncolor}{navyblue}
\hypersetup{colorlinks, urlcolor=navyblue, linkcolor=navyblue,
  pdftitle={<< meta.pdf_title >>}, pdfauthor={<< cv.header.name >>}}

%----------------------------------------------------------------------------------------
%   Customizations
%----------------------------------------------------------------------------------------

% Define italicitem, bolditem, and plainitem commands
\newcommand{\italicitem}[1]{\item{\textit{#1}}}
\newcommand{\bolditem}[1]{\item{\textbf{#1}}}
\newcommand{\plainitem}[1]{\item{#1}}

% Define user-friendly link command for hyperlinks
\newcommand{\link}[2]{{\href{#1}{#2}}}

\newcommand{\entry}[2]{#1 & #2 \tabularnewline} % Defines an entry with two arguments: #1 for the first column and #2 for the second column

%----------------------------------------------------------------------------------------
%   Define envsection command for defining a new environment section
%----------------------------------------------------------------------------------------

\newcommand{\tableEnv}[2]{%
  \begin{rSection}{#1} % Begin rSection with the given name
    \begin{adjustwidth}{0.0in}{0.1in} % Set the left and right margins
      \begin{tabularx}{\linewidth}{@{} >{\bfseries}l @{\hspace{6ex}} X @{}}
        #2 % Print the content inside the tabularx environment
      \end{tabularx}
    \end{adjustwidth}
  \end{rSection}
}

<# ------------------------------------------------------------------ section renderers #>
<% macro entries(title, rows) %>
\tableEnv{<< title >>}{
<% for label, text in rows %>
    \entry{<< label >>}{<< text >>}
<% endfor %>
}
<% endmacro %>

<% macro section_summary() %>
\begin{rSection}{<< labels.summary >>}
    << cv.summary >>
\end{rSection}
<% endmacro %>

<% macro jobs(title, list) %>
\begin{rSection}{<< title >>}

<% for r in list %>
    \begin{rSubsection}{<< r.organization >>}{<< r.dates >>}{<< r.title >>}{<< r.location >>}
<% if r.description %>
        \item \textit{<< r.description >>}
<% endif %>
<% for b in r.bullets %>
        \item << b.text >>
<% endfor %>
<% if not r.bullets and not r.description %>
        \item[]
<% endif %>
    \end{rSubsection}

<% endfor %>
\end{rSection}
<% endmacro %>

<% macro section_experience() %>
<< jobs(labels.experience, cv.experience) >>
<% endmacro %>

<% macro section_volunteering() %>
<< jobs(labels.volunteering, cv.volunteering) >>
<% endmacro %>

<% macro section_education() %>
\begin{rSection}{<< labels.education >>}

<% for e in cv.education %>
    \begin{rSubsectionNoBullet}{\bf << e.degree_line or e.institution >>}{<< e.institution if e.degree_line else '' >>}{<< e.location >>}{<< e.dates >>}
<% for d in e.details %>
        \italicitem{<< d >>}
<% endfor %>
<% if not e.details %>
        \item[]
<% endif %>
    \end{rSubsectionNoBullet}

<% endfor %>
\end{rSection}
<% endmacro %>

<% macro section_projects() %>
\begin{rSection}{<< labels.projects >>}

<% for p in cv.projects %>
    \begin{rSubsection}{<% if p.url %>\link{<< p.url >>}{<< p.name >>}<% else %><< p.name >><% endif %>}{<< p.dates >>}{<< p.role >><% if p.role and p.tech %> -- <% endif %><< p.tech | join(', ') >>}{}
<% if p.description %>
        \item << p.description >>
<% endif %>
<% for b in p.bullets %>
        \item << b.text >>
<% endfor %>
<% if not p.bullets and not p.description %>
        \item[]
<% endif %>
    \end{rSubsection}

<% endfor %>
\end{rSection}
<% endmacro %>

<% macro section_skills() %>
<% set rows = [] %>
<% for s in cv.skills %><% set _ = rows.append((s.category, s['items'] | join(', '))) %><% endfor %>
<< entries(labels.skills, rows) >>
<% endmacro %>

<% macro section_competencies() %>
<% set rows = [] %>
<% for c in cv.competencies %><% set _ = rows.append((c.name, c.text)) %><% endfor %>
<< entries(labels.competencies, rows) >>
<% endmacro %>

<% macro section_certifications() %>
<% set rows = [] %>
<% for c in cv.certifications %><% set _ = rows.append((c.when, c.name ~ (', ' ~ c.issuer if c.issuer else ''))) %><% endfor %>
<< entries(labels.certifications, rows) >>
<% endmacro %>

<% macro section_languages() %>
<% set rows = [] %>
<% for l in cv.languages %><% set _ = rows.append((l.language, l.level)) %><% endfor %>
<< entries(labels.languages, rows) >>
<% endmacro %>

<% macro section_awards() %>
<% set rows = [] %>
<% for a in cv.awards %><% set _ = rows.append((a.dates, a.name ~ (', ' ~ a.issuer if a.issuer else '') ~ (' -- ' ~ a.description if a.description else ''))) %><% endfor %>
<< entries(labels.awards, rows) >>
<% endmacro %>

<% macro section_publications() %>
<% set rows = [] %>
<% for p in cv.publications %><% set _ = rows.append((p.year, (p.authors ~ '. ' if p.authors else '') ~ ('\\link{' ~ p.url ~ '}{\\textit{' ~ p.title ~ '}}' if p.url else '\\textit{' ~ p.title ~ '}') ~ ('. ' ~ p.venue if p.venue else ''))) %><% endfor %>
<< entries(labels.publications, rows) >>
<% endmacro %>

<% macro section_achievements() %>
\begin{rSection}{<< labels.achievements >>}
    \begin{list}{$\cdot$}{\leftmargin=0em}\itemsep -0.5em
<% for a in cv.achievements %>
        \plainitem{<% if a.title %>\textbf{<< a.title >>}<% if a.text %> -- <% endif %><% endif %><< a.text >>}
<% endfor %>
    \end{list}
\end{rSection}
<% endmacro %>

<% macro section_interests() %>
\begin{rSection}{<< labels.interests >>}
    << cv.interests | join(', ') >>
\end{rSection}
<% endmacro %>

<% macro section_references() %>
\begin{rSection}{<< labels.references >>}
    << cv.references >>
\end{rSection}
<% endmacro %>

<% macro section_custom() %>
<% for c in cv.custom %>
\begin{rSection}{<< c.title >>}
<% if c.text %>
    << c.text >>
<% endif %>
<% if c['items'] %>
    \begin{list}{$\cdot$}{\leftmargin=0em}\itemsep -0.5em
<% for i in c['items'] %>
        \item << i >>
<% endfor %>
    \end{list}
<% endif %>
\end{rSection}
<% endfor %>
<% endmacro %>

<% set render_section = {
  'summary': section_summary, 'experience': section_experience, 'volunteering': section_volunteering,
  'projects': section_projects, 'education': section_education, 'skills': section_skills,
  'certifications': section_certifications, 'languages': section_languages, 'awards': section_awards,
  'publications': section_publications, 'competencies': section_competencies,
  'achievements': section_achievements, 'interests': section_interests, 'references': section_references,
  'custom': section_custom} %>
%----------------------------------------------------------------------------------------
%   Begin document
%----------------------------------------------------------------------------------------

% Set name with navyblue color
\name{\color{navyblue} << cv.header.name >>}

\begin{document}

<% set contact = [] %>
<% if cv.header.email %><% set _ = contact.append('\\tag{' ~ words.email ~ '}\\info{\\link{' ~ cv.header.email_url ~ '}{' ~ cv.header.email ~ '}}') %><% endif %>
<% if cv.header.phone %><% set _ = contact.append('\\tag{' ~ words.phone ~ '}\\info{' ~ cv.header.phone ~ '}') %><% endif %>
\printPersonalInfo{
<% if cv.header.headline %>
  \personalInfo{\textit{\color{navyblue} << cv.header.headline >>}}
<% endif %>
<% if cv.header.location %>
  \personalInfo{\tag{<< words.residence >>}\info{<< cv.header.location >>}}
<% endif %>
<% if contact %>
  \personalInfo{<< contact | join(' \\infoSeparator') >>}
<% endif %>
<% if cv.header.links %>
  \personalInfo{<% for l in cv.header.links %>\link{<< l.url >>}{<< l.label >>}<% if not loop.last %> \infoSeparator <% endif %><% endfor %>}
<% endif %>
}
<% for key in meta.sections %>

%----------------------------------------------------------------------------------------
%   << key >> section
%----------------------------------------------------------------------------------------

<< render_section[key]() >>
<% endfor %>
<% if cv.gdpr_clause %>

\vfill
{\scriptsize << cv.gdpr_clause >>\par}
<% endif %>

\end{document}
