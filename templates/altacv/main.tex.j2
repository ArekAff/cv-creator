%%%%%%%%%%%%%%%%
% Generated by CV Creator from cv.yaml. altacv.cls next to this file is a compatible reimplementation
% (the original class is not on CTAN/MiKTeX); the original works too if you put it here instead.

\documentclass[<< meta.font_size >>,<< meta.paper >>paper,withhyper<% if meta.options.get('normalphoto') %>,normalphoto<% endif %>]{altacv}

% Change the page layout if you need to
\geometry{left=1.25cm,right=1.25cm,top=1.5cm,bottom=1.5cm,columnsep=1.2cm}

% The paracol package lets you typeset columns of text in parallel
\usepackage{paracol}

% Change the font if you want to, depending on whether
% you're using pdflatex or xelatex/lualatex
\iftutex
  % If using xelatex or lualatex:
  \setmainfont{Roboto Slab}
  \setsansfont{Lato}
  \renewcommand{\familydefault}{\sfdefault}
\else
  % If using pdflatex:
  \usepackage[rm]{roboto}
  \usepackage[defaultsans]{lato}
  % \usepackage{sourcesanspro}
  \renewcommand{\familydefault}{\sfdefault}
\fi
\usepackage[<< meta.babel >>]{babel}

% Change the colours if you want to
\definecolor{SlateGrey}{HTML}{2E2E2E}
\definecolor{LightGrey}{HTML}{666666}
\definecolor{DarkPastelRed}{HTML}{450808}
\definecolor{PastelRed}{HTML}{8F0D0D}
\definecolor{GoldenEarth}{HTML}{E7D192}
<% if meta.accent %>
\definecolor{PastelRed}{HTML}{<< meta.accent >>}
\colorlet{DarkPastelRed}{PastelRed!70!black}
<% endif %>
\colorlet{name}{black}
\colorlet{tagline}{PastelRed}
\colorlet{heading}{DarkPastelRed}
\colorlet{headingrule}{GoldenEarth}
\colorlet{subheading}{PastelRed}
\colorlet{accent}{PastelRed}
\colorlet{emphasis}{SlateGrey}
\colorlet{body}{LightGrey}

% Change some fonts, if necessary
\renewcommand{\namefont}{\Huge\rmfamily\bfseries}
\renewcommand{\personalinfofont}{\footnotesize}
\renewcommand{\cvsectionfont}{\LARGE\rmfamily\bfseries}
\renewcommand{\cvsubsectionfont}{\large\bfseries}

% Change the bullets for itemize and rating marker
% for \cvskill if you want to
\renewcommand{\cvItemMarker}{{\small\textbullet}}
\renewcommand{\cvRatingMarker}{\faCircle}
<% if meta.language.startswith('pl') %>
\renewcommand{\locationname}{Miejsce}
\renewcommand{\datename}{Data}
<% elif meta.language.startswith('de') %>
\renewcommand{\locationname}{Ort}
\renewcommand{\datename}{Datum}
<% endif %>

% Extra info fields for links that have no built-in command
\NewInfoField{gitlab}{\faGitlab}[https://gitlab.com/]
\NewInfoField*{weblink}{\faLink}
\hypersetup{pdftitle={<< meta.pdf_title >>}, pdfauthor={<< cv.header.name >>}}

<# ------------------------------------------------------------------ section renderers #>
<% macro bullets(items) %>
<% if items %>
\begin{itemize}
<% for b in items %>
\item << b.text >>
<% endfor %>
\end{itemize}
<% endif %>
<% endmacro %>

<% macro events(title, list) %>
\cvsection{<< title >>}

<% for r in list %>
\cvevent{<< r.title >>}{<< r.organization >>}{<< r.dates >>}{<< r.location >>}
<% if r.description %>
\textit{<< r.description >>}\par
<% endif %>
<< bullets(r.bullets) >>
<% if not loop.last %>

\divider

<% endif %>
<% endfor %>
<% endmacro %>

<% macro section_summary() %>
\cvsection{<< labels.summary >>}

<< cv.summary >>\par
<% endmacro %>

<% macro section_experience() %>
<< events(labels.experience, cv.experience) >>
<% endmacro %>

<% macro section_volunteering() %>
<< events(labels.volunteering, cv.volunteering) >>
<% endmacro %>

<% macro section_projects() %>
\cvsection{<< labels.projects >>}

<% for p in cv.projects %>
\cvevent{<% if p.url %>\href{<< p.url >>}{<< p.name >>}<% else %><< p.name >><% endif %>}{<< p.role >><% if p.role and p.tech %> · <% endif %><< p.tech | join(', ') >>}{<< p.dates >>}{}
<% if p.description %>
<< p.description >>\par
<% endif %>
<< bullets(p.bullets) >>
<% if not loop.last %>

\divider

<% endif %>
<% endfor %>
<% endmacro %>

<% macro section_education() %>
\cvsection{<< labels.education >>}

<% for e in cv.education %>
\cvevent{<< e.degree_line or e.institution >>}{<< e.institution if e.degree_line else '' >>}{<< e.dates >>}{<< e.location >>}
<% for d in e.details %>
<< d >>\par
<% endfor %>
<% if not loop.last %>

\divider

<% endif %>
<% endfor %>
<% endmacro %>

<% macro section_achievements() %>
\cvsection{<< labels.achievements >>}

<% for a in cv.achievements %>
\cvachievement{\<< a.icon >>}{<< a.title >>}{<< a.text >>}
<% if not loop.last %>

\divider

<% endif %>
<% endfor %>
<% endmacro %>

<% macro section_competencies() %>
\cvsection{<< labels.competencies >>}

<% for c in cv.competencies %>
\cvachievement{\faCheck}{<< c.name >>}{<< c.text >>}
<% if not loop.last %>

\divider

<% endif %>
<% endfor %>
<% endmacro %>

<% macro section_skills() %>
\cvsection{<< labels.skills >>}

<% for s in cv.skills %>
<% if s.category %>
{\color{emphasis}\bfseries << s.category >>}\par\smallskip
<% endif %>
<% for item in s.rated %>
<% if item.ratio is not none %>
\cvskill{<< item.name >>}{<< ((item.ratio * 10) | round / 2) >>}
<% elif item.name | length > 30 %>
<< item.name >>\par
<% else %>
\cvtag{<< item.name >>}
<% endif %>
<% endfor %>
<% if not loop.last %>

\divider\smallskip

<% endif %>
<% endfor %>
<% endmacro %>

<% macro section_languages() %>
\cvsection{<< labels.languages >>}

<% for l in cv.languages %>
\cvskill{<< l.language >><% if l.level %> {\normalfont\small(<< l.level >>)}<% endif %>}{<< l.rating >>}
<% if not loop.last %>
\divider
<% endif %>
<% endfor %>
<% endmacro %>

<% macro section_certifications() %>
\cvsection{<< labels.certifications >>}

<% for c in cv.certifications %>
{\color{emphasis}\bfseries << c.name >>}\par
{\small << c.issuer >>\hfill << c.when >>}\par
<% if not loop.last %>
\divider
<% endif %>
<% endfor %>
<% endmacro %>

<% macro section_awards() %>
\cvsection{<< labels.awards >>}

<% for a in cv.awards %>
\cvachievement{\faTrophy}{<< a.name >>}{<< a.issuer >><% if a.issuer and a.dates %>, <% endif %><< a.dates >><% if a.description %>: << a.description >><% endif %>}
<% if not loop.last %>

\divider

<% endif %>
<% endfor %>
<% endmacro %>

<% macro section_publications() %>
\cvsection{<< labels.publications >>}

<% for p in cv.publications %>
<% if p.authors %><< p.authors >>. <% endif %><% if p.url %>\href{<< p.url >>}{\textit{<< p.title >>}}<% else %>\textit{<< p.title >>}<% endif %><% if p.venue %>. << p.venue >><% endif %><% if p.year %>, << p.year >><% endif %>.\par\medskip
<% endfor %>
<% endmacro %>

<% macro section_interests() %>
\cvsection{<< labels.interests >>}

<% for i in cv.interests %>
\cvtag{<< i >>}
<% endfor %>
<% endmacro %>

<% macro section_references() %>
\cvsection{<< labels.references >>}

<< cv.references >>\par
<% endmacro %>

<% macro section_custom() %>
<% for c in cv.custom %>
\cvsection{<< c.title >>}

<% if c.text %>
<< c.text >>\par
<% endif %>
<% if c['items'] %>
\begin{itemize}
<% for i in c['items'] %>
\item << i >>
<% endfor %>
\end{itemize}
<% endif %>
<% endfor %>
<% endmacro %>

<% set render_section = {
  'summary': section_summary, 'experience': section_experience, 'volunteering': section_volunteering,
  'projects': section_projects, 'education': section_education, 'skills': section_skills,
  'certifications': section_certifications, 'languages': section_languages, 'awards': section_awards,
  'publications': section_publications, 'competencies': section_competencies,
  'achievements': section_achievements, 'interests': section_interests, 'references': section_references,
  'custom': section_custom} %>
\begin{document}
\name{<< cv.header.name >>}
<% if cv.header.headline %>
\tagline{<< cv.header.headline >>}
<% endif %>
<% if meta.photo %>
%% You can add multiple photos on the left or right
\photoR{2.8cm}{<< meta.photo >>}
<% endif %>

\personalinfo{%
<% if cv.header.email %>
  \email{<< cv.header.email >>}
<% endif %>
<% if cv.header.phone %>
  \phone{<< cv.header.phone >>}
<% endif %>
<% if cv.header.location %>
  \location{<< cv.header.location >>}
<% endif %>
<% for l in cv.header.links %>
<% if l.kind in ('linkedin', 'github', 'gitlab', 'orcid') %>
  \<< l.kind >>{<< l.handle >>}
<% elif l.kind == 'website' %>
  \homepage{<< l.label >>}
<% else %>
  \weblink{<< l.label >>}{<< l.url >>}
<% endif %>
<% endfor %>
}

\makecvheader
%% Depending on your tastes, you may want to make fonts of itemize environments slightly smaller
% \AtBeginEnvironment{itemize}{\small}

%% Set the left/right column width ratio.
\columnratio{<< meta.options.get('column_ratio', 0.6) >>}

% Start a 2-column paracol. Both the left and right columns will automatically
% break across pages if things get too long.
\begin{paracol}{2}
<% for key in meta.main %>
<< render_section[key]() >>

<% endfor %>
%% Switch to the right column. This will now automatically move to the second
%% page if the content is too long.
\switchcolumn
<% for key in meta.side %>
<< render_section[key]() >>

<% endfor %>
\end{paracol}
<% if cv.gdpr_clause %>

\vfill
{\scriptsize << cv.gdpr_clause >>\par}
<% endif %>

\end{document}
