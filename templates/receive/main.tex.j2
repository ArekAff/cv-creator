% ReCeiVe
% LuaLaTeX Template
% Version 1.12.0 (10/10/2020)
%
% Original authors:
% Ged Lex (gedlex@hotmail.ch)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Generated by CV Creator from cv.yaml. ReCeiVe.cls next to this file is a compatible
% reimplementation that compiles with pdfLaTeX, XeLaTeX and LuaLaTeX.
<% set side_ok = ['summary', 'competencies', 'skills', 'languages', 'certifications', 'achievements', 'interests', 'references', 'awards'] %>
<% set side_keys = meta.side | select('in', side_ok) | list %>
<% set main_keys = meta.sections | reject('in', side_keys) | list %>

%----------------------------------------------------------------------------------------
%	PACKAGES AND OTHER DOCUMENT CONFIGURATIONS
%----------------------------------------------------------------------------------------
\documentclass[<< 'rightPos' if meta.options.get('sidebar_position') == 'right' else 'leftPos' >>,<< meta.paper >>paper,<< meta.font_size >>]{ReCeiVe}
\usepackage[<< meta.babel >>]{babel}

% Color for highlights
<% if meta.accent %>
\definecolor{highlight}{HTML}{<< meta.accent >>} % Specify your own color
<% else %>
%\definecolor{highlight}{HTML}{EB9534} % Specify your own color
<% endif %>
% Default colors include: darkgray, gray, lightgray, lightblue, orange, red, concrete

% Section names in the sidebar
\renewcommand{\contactname}{<< labels.contact >>}
\renewcommand{\aboutmename}{<< labels.about >>}
\renewcommand{\skillsname}{<< labels.skills >>}
\renewcommand{\languagesname}{<< labels.languages >>}
\hypersetup{pdftitle={<< meta.pdf_title >>}, pdfauthor={<< cv.header.name >>}}

%----------------------------------------------------------------------------------------
%	PERSONAL INFORMATION
%	Comment any of the lines below if they are not required
%----------------------------------------------------------------------------------------
<% if meta.photo %>
\photo[circle,edge]{3cm}{<< meta.photo >>}
<% endif %>
\name{<< cv.header.first_name >>}{<< cv.header.last_name >>}
<% if cv.header.location %>
\address{<< cv.header.location >>}
<% endif %>
<% if cv.header.phone %>
\mobile{<< cv.header.phone >>}
<% endif %>
<% if cv.header.email %>
\email{<< cv.header.email >>}
<% endif %>
<% for l in cv.header.links %>
<% if l.kind in ('linkedin', 'github') %>
\<< l.kind >>{<< l.handle >>}
<% else %>
\contactlink{<< l.icon >>}{<< l.label >>}{<< l.url >>}
<% endif %>
<% endfor %>

<% if cv.header.headline %>
\position{<< cv.header.headline >>} % Your expertise/fields
<% endif %>
<% if meta.options.get('headwords') %>
\headwords{<< meta.options.get('headwords') >>} % A few headwords to describe yourself
<% endif %>
<% if cv.header.quote %>
\quote{<< cv.header.quote >>} % A quote or statement
<% endif %>

%----------------------------------------------------------------------------------------
%	SIDEBAR CONTENT
%----------------------------------------------------------------------------------------
<% for key in side_keys %>
<% if key == 'summary' %>
\aboutMe{<< cv.summary >>}
<% elif key == 'skills' %>
\userSection[<< labels.skills >>]{%
<% for s in cv.skills %>
<% if s.category %>
  {\small\bfseries << s.category >>}\par\vspace{2pt}
<% endif %>
<% set plain = [] %>
<% for item in s.rated %>
<% if item.ratio is not none %>
  \skillbar{<< item.name >>}{<< item.ratio >>}
<% else %>
<% set _ = plain.append(item.name) %>
<% endif %>
<% endfor %>
<% if plain %>
  {\small << plain | join(', ') >>\par}
<% endif %>
  \vspace{4pt}
<% endfor %>
}
<% elif key == 'languages' %>
\userSection[<< labels.languages >>]{%
<% for l in cv.languages %>
  {\small\textbf{<< l.language >>}\hfill << l.level >>\par}
<% endfor %>
}
<% elif key == 'competencies' %>
\userSection[<< labels.competencies >>]{%
<% for c in cv.competencies %>
  {\small\textbf{<< c.name >>}<% if c.text %>\\ << c.text >><% endif %>\par}\vspace{3pt}
<% endfor %>
}
<% elif key == 'certifications' %>
\userSection[<< labels.certifications >>]{%
<% for c in cv.certifications %>
  {\small\textbf{<< c.name >>}\\ << c.issuer >><% if c.issuer and c.when %>, <% endif %><< c.when >>\par}\vspace{3pt}
<% endfor %>
}
<% elif key == 'achievements' %>
\userSection[<< labels.achievements >>]{%
<% for a in cv.achievements %>
  {\small {\color{highlight}\<< a.icon >>}~\textbf{<< a.title >>}<% if a.text %>\\ << a.text >><% endif %>\par}\vspace{3pt}
<% endfor %>
}
<% elif key == 'awards' %>
\userSection[<< labels.awards >>]{%
<% for a in cv.awards %>
  {\small\textbf{<< a.name >>}\\ << a.issuer >><% if a.issuer and a.dates %>, <% endif %><< a.dates >>\par}\vspace{3pt}
<% endfor %>
}
<% elif key == 'interests' %>
\userSection[<< labels.interests >>]{{\small << cv.interests | join(', ') >>\par}}
<% elif key == 'references' %>
\userSection[<< labels.references >>]{{\small << cv.references >>\par}}
<% endif %>
<% endfor %>

<# ------------------------------------------------------------------ main column renderers #>
<% macro bullets(items) %>
<% if items %>
\begin{itemize}
<% for b in items %>
  \item << b.text >>
<% endfor %>
\end{itemize}
<% endif %>
<% endmacro %>

<% macro events(title, list) %>
\cvsection{<< title >>}
<% for r in list %>
\cvevent{<< r.dates >>}{<< r.title >>}{<< r.organization >>}{<< r.location >>}
<% if r.description %>
{\small\itshape << r.description >>\par}
<% endif %>
<< bullets(r.bullets) >>
\medskip
<% endfor %>
<% endmacro %>

<% macro main_section(key) %>
<% if key == 'summary' %>
\cvsection{<< labels.summary >>}
<< cv.summary >>\par
<% elif key == 'experience' %>
<< events(labels.experience, cv.experience) >>
<% elif key == 'volunteering' %>
<< events(labels.volunteering, cv.volunteering) >>
<% elif key == 'projects' %>
\cvsection{<< labels.projects >>}
<% for p in cv.projects %>
\cvevent{<< p.dates >>}{<% if p.url %>\href{<< p.url >>}{<< p.name >>}<% else %><< p.name >><% endif %>}{<< p.role >>}{<< p.tech | join(', ') >>}
<% if p.description %>
{\small << p.description >>\par}
<% endif %>
<< bullets(p.bullets) >>
\medskip
<% endfor %>
<% elif key == 'education' %>
\cvsection{<< labels.education >>}
<% for e in cv.education %>
\cvevent{<< e.dates >>}{<< e.degree_line or e.institution >>}{<< e.institution if e.degree_line else '' >>}{<< e.location >>}
<% for d in e.details %>
{\small << d >>\par}
<% endfor %>
\medskip
<% endfor %>
<% elif key == 'competencies' %>
\cvsection{<< labels.competencies >>}
<% for c in cv.competencies %>
\textbf{<< c.name >>}<% if c.text %> --- << c.text >><% endif %>\par
<% endfor %>
<% elif key == 'skills' %>
\cvsection{<< labels.skills >>}
<% for s in cv.skills %>
<% if s.category %>\textbf{<< s.category >>}: <% endif %><< s['items'] | join(', ') >>\par
<% endfor %>
<% elif key == 'certifications' %>
\cvsection{<< labels.certifications >>}
<% for c in cv.certifications %>
\cvevent{<< c.when >>}{<< c.name >>}{<< c.issuer >>}{}
<% endfor %>
<% elif key == 'languages' %>
\cvsection{<< labels.languages >>}
<% for l in cv.languages %>\textbf{<< l.language >>} << l.level >><% if not loop.last %> \quad <% endif %><% endfor %>\par
<% elif key == 'awards' %>
\cvsection{<< labels.awards >>}
<% for a in cv.awards %>
\cvevent{<< a.dates >>}{<< a.name >>}{<< a.issuer >>}{}
<% if a.description %>
{\small << a.description >>\par}
<% endif %>
<% endfor %>
<% elif key == 'publications' %>
\cvsection{<< labels.publications >>}
<% for p in cv.publications %>
<% if p.authors %><< p.authors >>. <% endif %><% if p.url %>\href{<< p.url >>}{\textit{<< p.title >>}}<% else %>\textit{<< p.title >>}<% endif %><% if p.venue %>. << p.venue >><% endif %><% if p.year %>, << p.year >><% endif %>.\par\smallskip
<% endfor %>
<% elif key == 'achievements' %>
\cvsection{<< labels.achievements >>}
\begin{itemize}
<% for a in cv.achievements %>
  \item <% if a.title %>\textbf{<< a.title >>}<% if a.text %>: <% endif %><% endif %><< a.text >>
<% endfor %>
\end{itemize}
<% elif key == 'interests' %>
\cvsection{<< labels.interests >>}
<< cv.interests | join(', ') >>\par
<% elif key == 'references' %>
\cvsection{<< labels.references >>}
<< cv.references >>\par
<% elif key == 'custom' %>
<% for c in cv.custom %>
\cvsection{<< c.title >>}
<% if c.text %>
<< c.text >>\par
<% endif %>
<% if c['items'] %>
\begin{itemize}
<% for i in c['items'] %>
  \item << i >>
<% endfor %>
\end{itemize}
<% endif %>
<% endfor %>
<% endif %>
<% endmacro %>
%----------------------------------------------------------------------------------------
\begin{document}
% Usage: \makecvfooter{<left>}{<center>}{<right>}
\makecvfooter{}{<< cv.header.name >>~~~·~~~<< words.cv >>}{\thepage}
% Print the header
% Usage: \makecvheader[<position>]
\makecvheader[L]
% Print the sidebar
\makecvsidebar

%----------------------------------------------------------------------------------------
%	CV/RESUME CONTENT
%----------------------------------------------------------------------------------------
<% for key in main_keys %>
<< main_section(key) >>
<% endfor %>
<% if cv.gdpr_clause %>

\vfill
{\scriptsize << cv.gdpr_clause >>\par}
<% endif %>
\end{document}
