%%%%%%%%%%%%%%%
% This CV example/template is based on my own
% CV which I (lamely attempted) to clean up, so that
% it's less of an eyesore and easier for others to use.
%
% LianTze Lim (liantze@gmail.com)
% 23 Oct, 2022
% 24 Aug, 2024 -- Updated X (Twitter) icon
%%%%%%%%%%%%%%%
% Generated by CV Creator from cv.yaml. settings.sty next to this file is a compatible
% reimplementation. Rubrics are written to rubric-*.tex by the filecontents environments below,
% so this one file is the whole CV (CurVe's \makerubric needs the rubrics as separate files).
<% set curve_languages = ['english', 'french', 'spanish', 'portuguese', 'italian', 'german', 'ngerman', 'dutch', 'danish', 'swedish', 'polish'] %>
\documentclass[<< meta.paper >>paper,skipsamekey,<< meta.font_size >>,<< meta.babel if meta.babel in curve_languages else 'english' >>]{curve}

% Most commands and style definitions are in settings.sty.
\usepackage{settings}

% Change the fonts if you want
\ifxetexorluatex % If you're using XeLaTeX or LuaLaTeX
  \usepackage{fontspec}
  \usepackage[p,osf,swashQ]{cochineal}
  \usepackage[medium,bold]{cabin}
  \usepackage[varqu,varl,scale=0.9]{zi4}
\else % If you're using pdfLaTeX or latex
  \usepackage[T1]{fontenc}
  \usepackage[p,osf,swashQ]{cochineal}
  \usepackage{cabin}
  \usepackage[varqu,varl,scale=0.9]{zi4}
\fi

<% if meta.accent %>
% Change the colours if you want
\definecolor{SwishLineColour}{HTML}{<< meta.accent >>}
\definecolor{MarkerColour}{HTML}{<< meta.accent >>}
<% endif %>
\hypersetup{pdftitle={<< meta.pdf_title >>}, pdfauthor={<< cv.header.name >>}}

<% if meta.photo %>
%% Photo is only shown if "fullonly" is included
\includecomment{fullonly}
<% else %>
\excludecomment{fullonly}
<% endif %>

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\leftheader{%
  {\LARGE\bfseries\sffamily << cv.header.name >>}
<% if cv.header.headline %>

  {\large\itshape << cv.header.headline >>}
<% endif %>

<% if cv.header.location %>
  \makefield{\faMapMarker}{<< cv.header.location >>}
<% endif %>
<% if cv.header.phone %>
  \makefield{\faPhone}{<< cv.header.phone >>}
<% endif %>
<% if cv.header.email %>
  \makefield{\faEnvelope[regular]}{\href{<< cv.header.email_url >>}{\texttt{<< cv.header.email >>}}}
<% endif %>
<% if cv.header.links %>

  %% Next line
<% for l in cv.header.links %>
  \makefield{<< l.icon >>}{\href{<< l.url >>}{\texttt{<< l.label >>}}}
<% endfor %>
<% endif %>
}

\rightheader{~}
<% if not meta.photo %>
\headerscale{.9}
<% endif %>
\begin{fullonly}
\photo[r]{<< meta.photo or 'photo' >>}
\photoscale{0.13}
\end{fullonly}

\title{Curriculum Vitae}

<# ------------------------------------------------------------------ rubric writers #>
<% macro jobs(title, list) %>
\begin{rubric}{<< title >>}
<% for r in list %>
\entry*[<< r.dates >>]
  \textbf{<< r.title >>,} << r.organization >><% if r.location %>, << r.location >><% endif %>.\par
<% if r.description %>
  \textit{<< r.description >>}\par
<% endif %>
<% if r.bullets %>
  \begin{itemize}
<% for b in r.bullets %>
  \item << b.text >>
<% endfor %>
  \end{itemize}
<% endif %>
<% endfor %>
\end{rubric}
<% endmacro %>

<% macro rubric_summary() %>
\begin{rubric}{<< labels.summary >>}
\text{<< cv.summary >>}
\end{rubric}
<% endmacro %>

<% macro rubric_experience() %><< jobs(labels.experience, cv.experience) >><% endmacro %>
<% macro rubric_volunteering() %><< jobs(labels.volunteering, cv.volunteering) >><% endmacro %>

<% macro rubric_projects() %>
\begin{rubric}{<< labels.projects >>}
<% for p in cv.projects %>
\entry*[<< p.dates >>]
  \textbf{<% if p.url %>\href{<< p.url >>}{<< p.name >>}<% else %><< p.name >><% endif %>}<% if p.role %>, << p.role >><% endif %><% if p.tech %> (<< p.tech | join(', ') >>)<% endif %>.\par
<% if p.description %>
  << p.description >>\par
<% endif %>
<% if p.bullets %>
  \begin{itemize}
<% for b in p.bullets %>
  \item << b.text >>
<% endfor %>
  \end{itemize}
<% endif %>
<% endfor %>
\end{rubric}
<% endmacro %>

<% macro rubric_education() %>
\begin{rubric}{<< labels.education >>}
<% for e in cv.education %>
\entry*[<< e.dates >>]
  \textbf{<< e.degree_line or e.institution >>,}<% if e.degree_line %> << e.institution >><% endif %><% if e.location %>, << e.location >><% endif %>.\par
<% for d in e.details %>
  << d >>\par
<% endfor %>
<% endfor %>
\end{rubric}
<% endmacro %>

<% macro rubric_skills() %>
\begin{rubric}{<< labels.skills >>}
<% for s in cv.skills %>
\entry*[<< s.category >>]
  << s['items'] | join(', ') >>
<% endfor %>
\end{rubric}
<% endmacro %>

<% macro rubric_competencies() %>
\begin{rubric}{<< labels.competencies >>}
<% for c in cv.competencies %>
\entry*[]
  \textbf{<< c.name >>}<% if c.text %>: << c.text >><% endif %>
<% endfor %>
\end{rubric}
<% endmacro %>

<% macro rubric_certifications() %>
\begin{rubric}{<< labels.certifications >>}
<% for c in cv.certifications %>
\entry*[<< c.when >>]
  \textbf{<< c.name >>}<% if c.issuer %>, << c.issuer >><% endif %>
<% endfor %>
\end{rubric}
<% endmacro %>

<% macro rubric_languages() %>
\begin{rubric}{<< labels.languages >>}
<% for l in cv.languages %>
\entry*[<< l.language >>]
  << l.level >>
<% endfor %>
\end{rubric}
<% endmacro %>

<% macro rubric_awards() %>
\begin{rubric}{<< labels.awards >>}
<% for a in cv.awards %>
\entry*[<< a.dates >>]
  \textbf{<< a.name >>}<% if a.issuer %>, << a.issuer >><% endif %><% if a.description %>: << a.description >><% endif %>
<% endfor %>
\end{rubric}
<% endmacro %>

<% macro rubric_publications() %>
\begin{rubric}{<< labels.publications >>}
<% for p in cv.publications %>
\entry*[<< p.year >>]
  <% if p.authors %><< p.authors >>. <% endif %><% if p.url %>\href{<< p.url >>}{\textit{<< p.title >>}}<% else %>\textit{<< p.title >>}<% endif %><% if p.venue %>. << p.venue >><% endif %>.
<% endfor %>
\end{rubric}
<% endmacro %>

<% macro rubric_achievements() %>
\begin{rubric}{<< labels.achievements >>}
<% for a in cv.achievements %>
\entry*[]
  <% if a.title %>\textbf{<< a.title >>}<% if a.text %>: <% endif %><% endif %><< a.text >>
<% endfor %>
\end{rubric}
<% endmacro %>

<% macro rubric_interests() %>
\begin{rubric}{<< labels.interests >>}
\text{<< cv.interests | join(', ') >>}
\end{rubric}
<% endmacro %>

<% macro rubric_references() %>
\begin{rubric}{<< labels.references >>}
\text{<< cv.references >>}
\end{rubric}
<% endmacro %>

<% macro rubric_custom() %>
<% for c in cv.custom %>
\begin{rubric}{<< c.title >>}
<% if c.text %>
\text{<< c.text >>}
<% endif %>
<% for i in c['items'] %>
\entry*[]
  << i >>
<% endfor %>
\end{rubric}
<% endfor %>
<% endmacro %>

<% set write_rubric = {
  'summary': rubric_summary, 'experience': rubric_experience, 'volunteering': rubric_volunteering,
  'projects': rubric_projects, 'education': rubric_education, 'skills': rubric_skills,
  'certifications': rubric_certifications, 'languages': rubric_languages, 'awards': rubric_awards,
  'publications': rubric_publications, 'competencies': rubric_competencies,
  'achievements': rubric_achievements, 'interests': rubric_interests, 'references': rubric_references,
  'custom': rubric_custom} %>
<% for key in meta.sections %>
\begin{filecontents*}[overwrite]{rubric-<< key >>.tex}
<< write_rubric[key]() >>
\end{filecontents*}
<% endfor %>

\begin{document}
\makeheaders[c]

<% for key in meta.sections %>
\makerubric{rubric-<< key >>}
<% endfor %>
<% if cv.gdpr_clause %>

\vfill
{\scriptsize << cv.gdpr_clause >>\par}
<% endif %>

\end{document}
